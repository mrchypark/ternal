# Copy to .env for Docker Compose. Replace placeholder secrets before real use.
# Compose fails fast when these required values are unset or empty.

RAUTHY_ISSUER=http://host.docker.internal:8080/auth/v1/
RAUTHY_CLIENT_ID=ternal
RAUTHY_CLIENT_SECRET=replace-me-rauthy-client-secret
RAUTHY_REDIRECT_URL=http://127.0.0.1:3000/auth/callback

RAUTHY_ADMIN_GROUP=ternal-admins
RAUTHY_GROUPS_CLAIM=groups

TERNAL_SESSION_KEY=replace-me-ternal-session-key-minimum-32-chars

# Only set to 1 behind a trusted reverse proxy that controls x-forwarded-for/x-real-ip.

# Optional comma-separated relay URLs used in generated agent ProxyCommand.
TERNAL_AGENT_RELAY_URLS=
TERNAL_AGENT_EXTRA_RELAY_URLS=
