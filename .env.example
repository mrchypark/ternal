# Copy to .env for Docker Compose. Replace placeholder secrets before real use.
# Compose fails fast when these required values are unset or empty.

TERNAL_OIDC_ISSUER=http://host.docker.internal:8080/auth/v1/
TERNAL_OIDC_CLIENT_ID=ternal
TERNAL_OIDC_CLIENT_SECRET=replace-me-oidc-client-secret
TERNAL_OIDC_REDIRECT_URL=http://127.0.0.1:3000/auth/callback

TERNAL_OIDC_ADMIN_GROUP=ternal-admins
TERNAL_OIDC_GROUPS_CLAIM=groups

TERNAL_SESSION_KEY=replace-me-ternal-session-key-minimum-32-chars
TERNAL_DATA_ADMIN_TOKEN=replace-me-ternal-data-token-minimum-32-chars
TERNAL_RELAY_ACCESS_TOKEN=replace-me-ternal-relay-token-minimum-32-chars

# Optional comma-separated relay URLs used in generated agent ProxyCommand.
TERNAL_AGENT_RELAY_URLS=
TERNAL_AGENT_EXTRA_RELAY_URLS=
