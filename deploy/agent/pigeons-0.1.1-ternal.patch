+impl TransportDiagnostics {
+    pub fn from_cli_or_env(value: Option<&str>) -> Result<Option<Self>> {
+        let Some(value) = value
+            .map(str::to_owned)
+            .or_else(|| std::env::var("PIGEONS_TRANSPORT_DIAGNOSTICS").ok())
+        else {
