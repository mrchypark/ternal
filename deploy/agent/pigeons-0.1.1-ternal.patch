+pub(crate) async fn copy_both<AR, AW, BR, BW>(
+    a_reader: &mut AR,
+    a_writer: &mut AW,
+    b_reader: &mut BR,
+    b_writer: &mut BW,
+) -> std::io::Result<(u64, u64)>
+where
+    AR: tokio::io::AsyncRead + Unpin,
+    AW: tokio::io::AsyncWrite + Unpin,
+    BR: tokio::io::AsyncRead + Unpin,
+    BW: tokio::io::AsyncWrite + Unpin,
+{
+    tokio::try_join!(
+        copy_flush_and_shutdown(a_reader, b_writer),
+        copy_flush_and_shutdown(b_reader, a_writer),
+    )
+}
+
+async fn copy_flush_and_shutdown<R, W>(reader: &mut R, writer: &mut W) -> std::io::Result<u64>
+where
+    R: tokio::io::AsyncRead + Unpin,
+    W: tokio::io::AsyncWrite + Unpin,
+{
+    let copied = copy_flush(reader, writer).await?;
+    writer.shutdown().await?;
+    Ok(copied)
 }
 
 /// Copy data from reader to writer, flushing after every write.
