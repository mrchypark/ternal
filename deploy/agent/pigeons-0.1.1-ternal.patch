+
+fn fly_endpoint_addr(
+    remote: EndpointId,
+    relay_urls: Vec<RelayUrl>,
+    direct_addresses: Vec<SocketAddr>,
+    custom_relay_mode: bool,
+) -> anyhow::Result<EndpointAddr> {
+    if custom_relay_mode && relay_urls.is_empty() && direct_addresses.is_empty() {
+        anyhow::bail!("custom relay routes require a remote relay or direct address");
+    }
+    Ok(relay_urls.into_iter().fold(
+        direct_addresses
+            .into_iter()
+            .fold(EndpointAddr::new(remote), |addr, direct| {
+                addr.with_ip_addr(direct)
+            }),
+        |addr, relay| addr.with_relay_url(relay),
+    ))
+}
