+    fn emit(&self, transport: &'static str) -> Result<()> {
+        let event = format!(
+            "{{\"schema\":\"pigeons.transport.v1\",\"event\":\"transport_changed\",\"transport\":\"{transport}\"}}\n"
+        );
+        match &self.sink {
+            DiagnosticsSink::Stderr => eprint!("{event}"),
+            DiagnosticsSink::File(path) => {
+                use std::io::Write as _;
+                std::fs::OpenOptions::new()
+                    .create(true)
+                    .append(true)
+                    .open(path)?
+                    .write_all(event.as_bytes())?;
+            }
+        }
+        Ok(())
+    }
+}
+
+fn classify_transport(connection: &Connection) -> &'static str {
+    connection
+        .paths()
+        .iter()
+        .find(|path| path.is_selected())
+        .map(|path| {
+            if path.is_ip() {
+                "direct"
+            } else if path.is_relay() {
+                "relay"
+            } else {
+                "unknown"
+            }
+        })
+        .unwrap_or("unknown")
+}
+
+fn relay_map(relay_urls: &[RelayUrl], extra_relay_urls: &[RelayUrl]) -> iroh::RelayMap {
+    let map = if relay_urls.is_empty() {
+        RelayMode::Default.relay_map()
+    } else {
+        relay_urls.iter().cloned().collect()
+    };
+    for url in extra_relay_urls {
+        map.insert(url.clone(), Arc::new(RelayConfig::from(url.clone())));
+    }
+    map
+}
