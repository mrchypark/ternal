+fn parse_relay_urls(urls: &[String], kind: &str) -> anyhow::Result<Vec<RelayUrl>> {
+    urls.iter()
+        .map(|url| {
+            RelayUrl::from_str(url).map_err(|e| anyhow::anyhow!("invalid {kind} URL '{url}': {e}"))
+        })
+        .collect()
