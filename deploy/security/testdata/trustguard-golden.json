            "message": "trustguard parameters must retain their protected label"
          },
          {
            "expression": "request.userInfo.username != 'system:serviceaccount:ternal-test:ternal-data'",
            "message": "the Ternal API service account cannot modify trustguard parameters"
          }
        ]
